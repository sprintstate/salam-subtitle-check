package model

import str
import mem

pub struct Cue:
    pub number: int = 0
    pub line: int = 0
    pub start_ms: int = 0
    pub end_ms: int = 0
    pub text: str = ""
end

pub struct Diagnostic:
    pub severity: str = "error"
    pub code: str = ""
    pub line: int = 0
    pub cue: int = 0
    pub message: str = ""
end

pub struct Document:
    pub cues: Vector<Cue>
    pub diagnostics: Vector<Diagnostic>
end

pub func NewDocument(): Document:
    ret Document {
        cues = Vector {} as Vector<Cue>, diagnostics = Vector {} as Vector<Diagnostic>
    }
end

pub func Add(doc &: Document, severity: str, code: str, line: int, cue: int, message: str):
    doc.diagnostics.push(
        Diagnostic {
            severity = severity, code = code, line = line, cue = cue, message = str.Clone(message)
        }
    )
end

pub func Count(doc: Document, severity: str): int:
    mut count := 0
    repeat doc.diagnostics.len() in i:
        if doc.diagnostics.get(i).severity == severity: count += 1 end
    end
    ret count
end

// Parsed documents own the joined cue text and diagnostic messages.
pub func Release(doc &: Document):
    repeat doc.cues.len() in i: mem.Free(doc.cues.get(i).text as void*) end
    repeat doc.diagnostics.len() in i: mem.Free(doc.diagnostics.get(i).message as void*) end
    doc.cues.free()
    doc.diagnostics.free()
end
