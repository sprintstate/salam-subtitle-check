package cli

import os
import mem

include timestamp "timestamp.salam"

if SALAM_OS_WINDOWS:
    extern:
        func __wgetmainargs(count: void*, values: void*, environment: void*, wildcards: int, startup: void*): int
        func WideCharToMultiByte(codepage: u32, flags: u32, src: void*, srclen: i32, dst: void*, dstlen: i32, def: void*, used: void*): i32
    end
end

pub struct Options:
    pub path: str = ""
    pub json: bool = false
    pub strict: bool = false
    pub help: bool = false
    pub max_cps: int = 20
    pub max_line: int = 42
    pub error: str = ""
end

// Salam 0.4.8 args() uses narrow Windows argv. Read the CRT's wide argv instead.
// Returned argument strings are owned and must be released with ReleaseArgs.
pub func Args(): Vector<str>:
    mut result := Vector {} as Vector<str>
    if SALAM_OS_WINDOWS:
        count := mem.AllocateZeroed(4 as u64) as int*
        values := mem.AllocateZeroed(sizeof(void*) as u64) as void**
        environment := mem.AllocateZeroed(sizeof(void*) as u64)
        startup := mem.AllocateZeroed(4 as u64)
        defer mem.Free(count as void*)
        defer mem.Free(values as void*)
        defer mem.Free(environment)
        defer mem.Free(startup)
        status := __wgetmainargs(count as void*, values as void*, environment, 0, startup)
        if status < 0: ret result end
        wide := values[0] as void**
        repeat count[0] in i:
            size := WideCharToMultiByte(65001 as u32, 128 as u32, wide[i], -1, null, 0, null, null)
            if size <= 0:
                ReleaseArgs(result)
                ret Vector {}
            end
            buffer := mem.AllocateZeroed(size as u64)
            written := WideCharToMultiByte(65001 as u32, 128 as u32, wide[i], -1, buffer, size, null, null)
            if written != size:
                mem.Free(buffer)
                ReleaseArgs(result)
                ret Vector {}
            end
            result.push(buffer as str)
        end
    else:
        native := os.Args()
        defer native.free()
        repeat native.len() in i:
            arg := native.get(i)
            result.push(arg.substr(0, arg.len()))
        end
    end
    ret result
end

pub func ReleaseArgs(args: Vector<str>):
    repeat args.len() in i: mem.Free(args.get(i) as void*) end
    args.free()
end

// Parsed options borrow strings from Args().
pub func Parse(args: Vector<str>): Options:
    mut result := Options {}
    mut positional := false
    mut i := 1
    until i < args.len():
        arg := args.get(i)
        if positional:
            if result.path != "":
                result.error = "Expected exactly one input file."
                ret result
            end
            result.path = arg
        else arg == "--": positional = true
        else arg == "--help" or arg == "-h": result.help = true
        else arg == "--json": result.json = true
        else arg == "--strict": result.strict = true
        else arg == "--max-cps" or arg == "--max-line":
            i += 1
            if i >= args.len():
                result.error = "A numeric option is missing its value."
                ret result
            end
            number := timestamp.PositiveInteger(args.get(i))
            if number < 1 or number > 1000:
                result.error = "Limits must be integers from 1 to 1000."
                ret result
            end
            if arg == "--max-cps": result.max_cps = number
            else:
                result.max_line = number
            end
        else arg.find("-") == 0:
            result.error = "Unknown option. Use -- before a filename starting with a dash."
            ret result
        else:
            if result.path != "":
                result.error = "Expected exactly one input file."
                ret result
            end
            result.path = arg
        end
        i += 1
    end
    if not result.help and result.path == "": result.error = "An input file is required." end
    ret result
end

pub func Help():
    println "Salam Subtitle Check - offline UTF-8 SRT validator"
    println "Usage: subtitle-check [options] [--] FILE.srt"
    println "  --json          Emit a machine-readable report"
    println "  --strict        Fail on warnings as well as errors"
    println "  --max-cps N     Reading-speed limit (default 20; range 1..1000)"
    println "  --max-line N    Characters per line (default 42; range 1..1000)"
    println "  -h, --help      Show this help"
    println "Exit: 0 accepted, 1 subtitle diagnostics, 2 usage or input failure"
end
