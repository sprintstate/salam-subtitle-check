import testing
import str
import mem

include timestamp "../src/timestamp.salam"
include model "../src/model.salam"
include parser "../src/parser.salam"
include timing "../src/timing.salam"
include readability "../src/readability.salam"

func Count(doc: model.Document, code: str): int:
    mut count := 0
    repeat doc.diagnostics.len() in i:
        if doc.diagnostics.get(i).code == code: count += 1 end
    end
    ret count
end

func main: int:
    testing.AssertEqInt(timestamp.Parse("00:00:00,000"), 0)
    testing.AssertEqInt(timestamp.Parse("01:02:03,004"), 3723004)
    testing.AssertEqInt(timestamp.Parse("99:59:59,999"), 359999999)
    testing.AssertEqInt(timestamp.Parse("00:60:00,000"), -1)
    testing.AssertEqInt(timestamp.Parse("00:00:60,000"), -1)
    testing.AssertEqInt(timestamp.Parse("0:00:00,000"), -1)
    testing.AssertEqInt(timestamp.Parse("00:00:00.000"), -1)
    testing.AssertEqInt(timestamp.Parse("00:00:00,00x"), -1)
    testing.AssertEqInt(timestamp.Parse("-1:00:00,000"), -1)
    testing.AssertEqInt(timestamp.Parse(" 00:00:00,000"), -1)
    testing.AssertEqInt(timestamp.Parse("00:00:00,000 "), -1)
    testing.AssertEqInt(timestamp.PositiveInteger("1"), 1)
    testing.AssertEqInt(timestamp.PositiveInteger("999999999"), 999999999)
    testing.AssertEqInt(timestamp.PositiveInteger("1000000000"), -1)
    testing.AssertEqInt(timestamp.PositiveInteger("12x"), -1)
    testing.AssertEqInt(timestamp.PositiveInteger("0"), -1)
    testing.AssertEqInt(timestamp.PositiveInteger(""), -1)
    testing.AssertEqInt(timestamp.PositiveInteger("-1"), -1)
    mut doc := model.NewDocument()
    model.Add(doc, "error", "E_TEST", 3, 1, "A diagnostic")
    testing.AssertEqInt(doc.diagnostics.len(), 1)
    testing.AssertEqStr(doc.diagnostics.get(0).code, "E_TEST")
    model.Release(doc)
    mut valid := parser.Parse("1\n00:00:01,000 --> 00:00:03,000\nHello\nworld\n\n2\n00:00:04,000 --> 00:00:06,000\nПривет!")
    testing.AssertEqInt(valid.cues.len(), 2)
    testing.AssertEqInt(valid.diagnostics.len(), 0)
    testing.AssertEqStr(valid.cues.get(0).text, "Hello\nworld")
    testing.AssertEqInt(valid.cues.get(1).line, 6)
    testing.AssertEqInt(valid.cues.get(1).start_ms, 4000)
    model.Release(valid)
    mut recovery := parser.Parse("x\nwrong\ntext\n\n2\n00:00:00,000 --> 00:00:02,000\nRecovered\n")
    testing.AssertEqInt(recovery.cues.len(), 1)
    testing.AssertEqInt(recovery.diagnostics.len(), 2)
    testing.AssertEqStr(recovery.diagnostics.get(0).code, "E_NUMBER")
    testing.AssertEqStr(recovery.diagnostics.get(1).code, "E_TIMING")
    testing.AssertEqInt(recovery.cues.get(0).line, 5)
    model.Release(recovery)
    mut empty := parser.Parse("\n  \n")
    testing.AssertEqStr(empty.diagnostics.get(0).code, "E_EMPTY")
    model.Release(empty)
    mut missing := parser.Parse("1\n00:00:00,000 --> 00:00:01,000\n\n")
    testing.AssertEqStr(missing.diagnostics.get(0).code, "E_TEXT")
    model.Release(missing)
    mut bad_time := parser.Parse("1\n00:00:00.000 --> 00:00:01,000\nText")
    testing.AssertEqStr(bad_time.diagnostics.get(0).code, "E_TIMESTAMP")
    model.Release(bad_time)
    mut builder := str.NewBuilder()
    repeat 5000:
        str.BufAppend(builder, "1\n00:00:00,000 --> 00:00:01,000\nx\n\n")
    end
    str.BufAppend(builder, "\n\n")
    maximum_text := str.BufStr(builder)
    mut maximum := parser.Parse(maximum_text)
    testing.AssertEqInt(maximum.cues.len(), 5000)
    testing.AssertEqInt(maximum.diagnostics.len(), 0)
    model.Release(maximum)
    mem.Free(maximum_text as void*)
    str.BufAppend(builder, "1\n00:00:00,000 --> 00:00:01,000\nx")
    excessive_text := str.BufStr(builder)
    mut excessive := parser.Parse(excessive_text)
    testing.AssertEqStr(excessive.diagnostics.get(0).code, "E_LIMIT")
    model.Release(excessive)
    mem.Free(excessive_text as void*)
    str.BufFree(builder)
    mut overlaps := parser.Parse("1\n00:00:00,000 --> 00:00:06,000\nx\n\n2\n00:00:01,000 --> 00:00:02,000\ny\n\n4\n00:00:03,000 --> 00:00:04,000\nz")
    timing.Check(overlaps)
    testing.AssertEqInt(Count(overlaps, "W_OVERLAP"), 2)
    testing.AssertEqInt(Count(overlaps, "W_SEQUENCE"), 1)
    model.Release(overlaps)
    mut durations := parser.Parse("1\n00:00:02,000 --> 00:00:02,000\nx\n\n2\n00:00:01,000 --> 00:00:00,000\ny\n\n3\n00:00:03,000 --> 00:00:03,499\nz\n\n4\n00:00:04,000 --> 00:00:11,001\nx")
    timing.Check(durations)
    testing.AssertEqInt(Count(durations, "E_DURATION"), 2)
    testing.AssertEqInt(Count(durations, "W_ORDER"), 1)
    testing.AssertEqInt(Count(durations, "W_SHORT"), 1)
    testing.AssertEqInt(Count(durations, "W_LONG"), 1)
    model.Release(durations)
    mut unicode := parser.Parse("1\n00:00:00,000 --> 00:00:01,000\nПривет\n世界\n🙂")
    readability.Check(unicode, 9, 6)
    testing.AssertEqInt(Count(unicode, "W_WIDTH"), 0)
    testing.AssertEqInt(Count(unicode, "W_CPS"), 0)
    testing.AssertEqInt(Count(unicode, "W_LINES"), 1)
    readability.Check(unicode, 8, 5)
    testing.AssertEqInt(Count(unicode, "W_WIDTH"), 1)
    testing.AssertEqInt(Count(unicode, "W_CPS"), 1)
    model.Release(unicode)
    ret testing.Summary() > 0 ? 1 : 0
end
